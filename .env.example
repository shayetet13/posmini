DATABASE_URL=sqlite://posmini.db?mode=rwc
BIND_ADDR=0.0.0.0:8080
SHOP_SLUG=main
SHOP_NAME=ร้านหลัก
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
COOKIE_SECURE=false

PAYMENT_API_BASE=https://your-api-host
PROMPTPAY_API_KEY=lbk_replace_me
PROMPTPAY_ID=0812345678
PAYMENT_DEST_LAST4=

# Developer option: write print jobs to this file instead of a printer (for testing)
# PRINT_DUMP_FILE=print-dump.bin

# Optional: Thai font file for image printing (default: Leelawadee UI / Tahoma from Windows)
# PRINT_FONT=C:\Windows\Fonts\LeelawUI.ttf

# Cloud deployment (see README): the backend serves only the API when the pages come from the
# separate frontend service. TRUST_PROXY makes login rate limits use the visitor's real IP.
# SERVE_UI=false
# TRUST_PROXY=true
